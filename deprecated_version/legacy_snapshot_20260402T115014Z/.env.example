# Example environment file for local development and future pipeline execution.
#
# Usage:
# 1. Copy this file to `.env`.
# 2. Fill in the real secrets and machine-specific values.
# 3. Keep `.env` out of version control.
#
# Notes:
# - Leave optional values empty if you are not using that integration yet.
# - API base URLs and most experiment settings should live in YAML configs.
# - This file is for secrets, paths, and machine/runtime defaults.

# -----------------------------------------------------------------------------
# Required provider credentials
# -----------------------------------------------------------------------------

# Twelve Data API key for daily OHLCV market data.
TWELVE_DATA_API_KEY=replace_with_real_key

# Finnhub API key for company news downloads.
FINNHUB_API_KEY=replace_with_real_key

# SEC fair-access identifier.
# Recommended format: Name email@example.com ProjectOrInstitution
SEC_USER_AGENT=Your Name your.email@example.com EventStateForecastingResearch


# AlphaVantage
ALPHAVANTAGE_API_KEY =replace_with_real_key


# -----------------------------------------------------------------------------
# Optional provider credentials
# -----------------------------------------------------------------------------

# Optional split/corporate-action provider.
# Use this only if Twelve Data plan access is insufficient for split events.
SPLIT_EVENTS_API_KEY=

# Optional Hugging Face token.
# Usually not required for public models, but useful for gated models or higher
# rate limits.
HF_TOKEN=

# Optional experiment tracking.
WANDB_API_KEY=


# -----------------------------------------------------------------------------
# Project paths
# -----------------------------------------------------------------------------

# Project root.
PROJECT_ROOT=.

# Data roots.
DATA_DIR=data
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_FINAL_DIR=data/final
DATA_EMBEDDINGS_DIR=data/embeddings
DATA_KB_DIR=data/kb
DATA_MANIFESTS_DIR=data/manifests

# Output roots.
ARTIFACTS_DIR=artifacts
CHECKPOINTS_DIR=artifacts/checkpoints
FIGURES_DIR=artifacts/figures
TABLES_DIR=artifacts/tables
RUNS_DIR=runs
REPORTS_DIR=reports
NOTEBOOKS_DIR=notebooks
LOGS_DIR=runs/logs


# -----------------------------------------------------------------------------
# Runtime defaults
# -----------------------------------------------------------------------------

# Device preference: `cuda`, `cpu`, or `mps` if ever needed elsewhere.
DEFAULT_DEVICE=cuda

# Reproducibility defaults.
DEFAULT_RANDOM_SEED=42
DEFAULT_NUM_WORKERS=4

# Logging defaults.
DEFAULT_LOG_LEVEL=INFO

# Calendar and time alignment defaults.
DEFAULT_TIMEZONE=UTC
MARKET_TIMEZONE=America/New_York
EXCHANGE_CALENDAR=XNYS
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0


# -----------------------------------------------------------------------------
# Data collection defaults
# -----------------------------------------------------------------------------

# Market data history defaults.
MARKET_START_DATE=2006-01-01
MARKET_END_DATE=
TWELVE_DATA_INTERVAL=1day
TWELVE_DATA_OUTPUTSIZE=5000
TWELVE_DATA_CREDITS_PER_MINUTE=8
TWELVE_DATA_CREDITS_PER_DAY=800

# News ingestion defaults.
FINNHUB_NEWS_CHUNK_DAYS=30
NEWS_LOOKBACK_DAYS=20
NEWS_DECAY_HALF_LIFE_DAYS=5
NEWS_USE_SUMMARY=true


# -----------------------------------------------------------------------------
# Embeddings and model-cache defaults
# -----------------------------------------------------------------------------

# Default embedding model identifier for article embeddings.
NEWS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local cache locations.
HF_HOME=.cache/huggingface
TRANSFORMERS_CACHE=.cache/huggingface/transformers
TORCH_HOME=.cache/torch


# -----------------------------------------------------------------------------
# Training and evaluation defaults
# -----------------------------------------------------------------------------

TRAIN_BATCH_SIZE=256
EVAL_BATCH_SIZE=512
USE_MIXED_PRECISION=true
USE_PIN_MEMORY=true


# -----------------------------------------------------------------------------
# Optional experiment tracking defaults
# -----------------------------------------------------------------------------

ENABLE_WANDB=false
WANDB_PROJECT=event-state-forecasting
WANDB_ENTITY=
